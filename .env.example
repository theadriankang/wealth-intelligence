# TinyFish Search + Fetch. Required for live Policy Sentinel scans.
TINYFISH_API_KEY=tf_live_or_test_key_here

# Optional: steer the policy scan toward the demo story.
POLICY_SCAN_QUERY=latest MAS monetary policy statement central bank policy speech Singapore
POLICY_SCAN_DOMAINS=mas.gov.sg,bis.org,federalreserve.gov,ecb.europa.eu
POLICY_SCAN_LOCATION=SG
POLICY_SCAN_LANGUAGE=en
POLICY_SCAN_RECENCY_MINUTES=
TINYFISH_FETCH_TTL=0
TINYFISH_FETCH_TIMEOUT_MS=45000

# Optional existing integrations.
WORLDMONITOR_API_KEY=
# LLM briefing: with no key the client thesis/summary fall back to a deterministic template — the rest of the app is identical.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# Optional: use Google Maps Platform Photorealistic 3D Tiles for the dashboard globe.
# Requires Map Tiles API enabled and billing on the Google Cloud project.
VITE_GLOBE_PROVIDER=wealth
VITE_GOOGLE_MAPS_API_KEY=

# Set to 1 only when rehearsing fully offline.
OFFLINE=0

# Rate limiting. The TinyFish account ceiling is 30 requests/minute across Search
# and Fetch together; 24 leaves headroom. FRED allows 120/min. Both are enforced
# by server/providers/ratelimit.js — raise only if your plan actually allows it.
TINYFISH_RATE_PER_MIN=24
TINYFISH_BURST=8
FRED_RATE_PER_MIN=90

# WORLDMONITOR_API_KEY is intentionally absent: there is no public signup, and
# the REST gateway 404s upstream (koala73/worldmonitor#4724). The client works
# without it and reports the real status. See server/providers/worldmonitor.js.
