# Copy to .env — never commit the real file.
PORT=8787

# World Monitor (https://worldmonitor.app) — the CLI/base dashboard works without a key,
# the REST API wants one for higher limits.
WORLDMONITOR_API_KEY=
WORLDMONITOR_BASE=https://api.worldmonitor.app

# LLM. Set ONE of these; server/llm.js picks whichever is present.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Set to 1 to force fixtures and never hit the network (safe demo mode).
OFFLINE=0
